NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_FILE=./data/localwork.sqlite
# Create the first admin account at server startup. Do not use a public admin signup form.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Optional comma-separated extra origins only if you later host the frontend separately.
CORS_ORIGINS=
# Resend email API key for password reset
RESEND_API_KEY=
EMAIL_FROM="LocalWork <onboarding@resend.dev>"
APP_BASE_URL=https://localwork-2-0.onrender.com
# Google Sign-In OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
