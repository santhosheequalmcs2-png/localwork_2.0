NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
DATABASE_FILE=./data/localwork.sqlite
# Create the first admin account at server startup. Do not use a public admin signup form.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-long-unique-password
# Optional comma-separated extra origins only if you later host the frontend separately.
CORS_ORIGINS=
